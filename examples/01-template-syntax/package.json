{
  "name": "@example/01-template-syntax",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --force",
    "lint": "eslint . && prettier --check \"src/**/*.{ts,vue,css}\"",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "clean": "rm -rf dist node_modules/.tmp"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.6.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.13"
  }
}
