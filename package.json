{
  "name": "vue-learning",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter \"./examples/*\" --parallel dev",
    "build": "pnpm --filter \"./examples/*\" --parallel build",
    "lint": "pnpm --filter \"./examples/*\" --parallel lint",
    "typecheck": "pnpm --filter \"./examples/*\" --parallel typecheck",
    "clean": "pnpm --filter \"./examples/*\" --parallel clean",
    "format:docs": "prettier --write \"docs/**/*.md\"",
    "format:docs:check": "prettier --check \"docs/**/*.md\"",
    "check:doc-sync": "python3 scripts/check-doc-code-sync.py",
    "docs:demo-links": "python3 scripts/add-demo-links.py"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
